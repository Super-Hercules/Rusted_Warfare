[core]
autoTriggerCooldownTime:0.1s
armour:0
strictLevel:0
[movement]
movementType:NONE
[hiddenAction_单位]
autoTrigger:true
temporarilyAddTags:单位
[hiddenAction_空中单位]
autoTrigger:if self.isFlying()
temporarilyAddTags:空军
[hiddenAction_陆军]
autoTrigger:if self.isAtGroundHeight()
temporarilyAddTags:陆军
[hiddenAction_修复错误陆军]
autoTrigger:if self.isFlying() and self.isMoving()
temporarilyRemoveTags:陆军

[resource_深渊灼烧]
displayName:深渊灼烧
displayColor:#66B3FF
hidden:false
[hiddenAction_深渊灼烧命中]
autoTrigger:if self.resource(type='深渊灼烧',greaterThan=0)
addResources: 深渊灼烧=-1, hp=-10000
[hiddenAction_混乱]
autoTrigger:if self.customTimer(laterThanSeconds=1) and self.resource(type='混乱',greaterThan=0)
clearAllWaypoints:true
addWaypoint_type:move
addWaypoint_position_randomOffsetFromSelf:100,100
addWaypoint_position_offsetFromSelf:0,0
addResources:混乱=-1
[resource_混乱]
displayName:混乱
displayColor:#66B3FF
hidden:false
[hiddenAction_威胁指数增加]
autoTriggerOnEvent:created
addResources:威胁指数=${core.price / 7500}
[hiddenAction_威胁指数减少]
autoTriggerOnEvent:destroyed
addResources:威胁指数=-${core.price / 7500}
[hiddenAction_威胁指数上调]
autoTriggerOnEvent:killedAnyUnit
addResources:威胁指数=0

[resource_脑波干扰T1]
displayName:脑波干扰T1
displayColor:#66B3FF
hidden:false
[hiddenAction_脑波干扰T11]
autoTrigger:if self.resource.脑波干扰T1==0
setUnitStats:shootDelayMultiplier=1
[hiddenAction_脑波干扰T12]
autoTrigger:if self.resource.脑波干扰T1>0
setUnitStats:shootDelayMultiplier=2
addResources:脑波干扰T1=-1
[resource_脑波干扰T2]
displayName:脑波干扰T2
displayColor:#66B3FF
hidden:false
[hiddenAction_脑波干扰T21]
autoTrigger:if self.resource.脑波干扰T2==0
setUnitStats:shootDelayMultiplier=1
[hiddenAction_脑波干扰T22]
autoTrigger:if self.resource.脑波干扰T2>0
setUnitStats:shootDelayMultiplier=4
addResources:脑波干扰T2=-1

[global_resource_威胁指数]
hidden:false
displayName:威胁指数
displayColor:#FF0000
priority:1
[global_resource_战争指数]
hidden:false
