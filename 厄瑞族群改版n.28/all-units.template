[hiddenAction_总时间]
autoTrigger:true
setResourcesWithLogic:"""
秒=int(createMarker(x=0,y=0).timeAlive%60),
分=int((createMarker(x=0,y=0).timeAlive%3600)/60),
时=int((createMarker(x=0,y=0).timeAlive%86400)/3600),
天=int(createMarker(x=0,y=0).timeAlive/86400)
"""
[global_resource_秒]
hidden:true
displayName:
displayPrefixInHUD::
displayPostfixInHUD:]
displayWhenZero:true
displayColor:#409A50
stackHorizontal:true
[global_resource_分]
@copyFromSection:global_resource_秒
appendResourceInHUD:秒
displayPostfixInHUD:
[global_resource_时]
@copyFromSection:global_resource_秒
appendResourceInHUD:分
displayPostfixInHUD:
[global_resource_天]
@copyFromSection:global_resource_秒
displayPos:-99999
hidden:false
displayPrefixInHUD:Time:[
displayPrefixInHUD_zh:时间:[
displayPostfixInHUD:
appendResourceInHUD:时